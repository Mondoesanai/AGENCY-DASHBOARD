{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/audit.js": { "maxDuration": 60 },
    "api/report.js": { "maxDuration": 60 },
    "api/sites.js": { "maxDuration": 60 },
    "api/cron-daily.js": { "maxDuration": 60 },
    "api/card.js": { "maxDuration": 30 }
  },
  "crons": [
    { "path": "/api/cron-daily", "schedule": "0 13 * * *" }
  ],
  "rewrites": [
    { "source": "/r/:slug", "destination": "/r.html?slug=:slug" }
  ],
  "headers": [
    {
      "source": "/t.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
